                  </div>

                  {/* Arrow indicator */}
                  <div className="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-white/5 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300">
                    <FaArrowRight className="text-pink-400 text-sm" />
                  </div>
                </div>
              </div>

              {/* Step 3 */}
              <div className="group animate-on-scroll" style={{ transitionDelay: '300ms' }}>
                <div className="relative p-8 rounded-[2rem] bg-gradient-to-br from-white/5 to-white/0 border border-white/10 hover:border-cyan-500/50 transition-all duration-500 h-full hover:-translate-y-2 hover:shadow-2xl hover:shadow-cyan-500/20 overflow-hidden">
                  {/* Glow Effect */}
                  <div className="absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                  <div className="absolute -top-20 -right-20 w-40 h-40 bg-cyan-500/20 rounded-full blur-3xl group-hover:bg-cyan-500/30 transition-all duration-500"></div>

                  <div className="relative z-10">
                    <div className="absolute -top-4 left-1/2 -translate-x-1/2 w-12 h-12 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center text-white font-black text-lg shadow-lg z-10 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                      3
                    </div>

                    <div className="flex justify-center mb-6 mt-4">
                      <div className="relative">
                        <div className="w-20 h-20 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-500/20 flex items-center justify-center group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-500 border border-white/10">
                          <FaChartLine className="text-3xl text-cyan-400" />
                        </div>
                        {/* Floating particles */}
                        <div className="absolute -top-2 -right-2 w-3 h-3 bg-cyan-500/50 rounded-full animate-pulse" style={{ animationDelay: '0.6s' }}></div>
                        <div className="absolute -bottom-2 -left-2 w-2 h-2 bg-blue-500/50 rounded-full animate-pulse" style={{ animationDelay: '1.1s' }}></div>
                      </div>
                    </div>

                    <h3 className="text-xl font-bold text-white mb-4 text-center group-hover:text-cyan-400 transition-colors duration-300">
                      Boost Productivity
                    </h3>
                    <p className="text-gray-400 leading-relaxed text-center mb-6 group-hover:text-gray-300 transition-colors duration-300">
                      Track progress, maintain streaks, and achieve your goals with smart insights.
                    </p>

                    <div className="bg-cyan-500/10 rounded-xl p-4 border border-cyan-500/20 group-hover:bg-cyan-500/20 transition-colors duration-300">
                      <div className="flex items-start gap-3">
                        <div className="w-6 h-6 rounded-full bg-cyan-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                          <span className="text-white text-xs font-bold">!</span>
                        </div>
                        <div>
                          <p className="text-cyan-300 text-sm font-medium mb-1">Quick Tip</p>
                          <p className="text-gray-400 text-xs group-hover:text-gray-300 transition-colors duration-300">
                            Enable streaks to build daily productivity habits
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Success badge */}
                  <div className="absolute top-4 right-4 w-10 h-10 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
                    <FaCheckCircle className="text-white text-lg" />
                  </div>
                </div>
              </div>
            </div>

          {/* Bottom CTA */}
          <div className="mt-16 text-center">
            <button
              onClick={handleGetStarted}
              className="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-2xl hover:from-purple-600 hover:to-pink-600 transition-all duration-300 shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 hover:scale-105"
            >
              <span>Start Your Journey</span>
              <FaArrowRight className="text-sm" />
            </button>
            <p className="text-gray-400 text-sm mt-4">
              Takes less than 2 minutes to get started
            </p>
          </div>
        </div>
      </div>
    </section>
      <section id="see-it-in-action" className="py-24 animate-on-scroll">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-16">
            <h2 className="text-4xl md:text-5xl font-black text-white mb-4">
              See It In Action
            </h2>
            <p className="text-xl text-gray-400 max-w-2xl mx-auto">
              Watch how TasklyPro transforms your productivity workflow
            </p>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {/* Left Side - Glassy Text Content */}
            <div className="relative">
              {/* Glassmorphism Card */}
              <div className="relative bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-2xl rounded-[2.5rem] p-8 border border-white/20 shadow-2xl overflow-hidden">
                {/* Animated gradient background */}
                <div className="absolute inset-0 bg-gradient-to-br from-purple-500/20 via-transparent to-pink-500/20 animate-pulse"></div>
                <div className="absolute top-[-50%] left-[-50%] w-[200%] h-[200%] bg-gradient-to-r from-purple-500/10 via-transparent to-pink-500/10 rounded-full blur-3xl animate-spin" style={{ animationDuration: '20s' }}></div>

                {/* Content */}
                <div className="relative z-10">
                  {/* Header */}
                  <div className="flex items-center gap-4 mb-8">
                    <div className="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-500/30">
                      <FaRocket className="text-white text-xl" />
                    </div>
                    <div>
                      <h3 className="text-2xl font-bold text-white">Your Productivity Journey</h3>
                      <p className="text-gray-400">From signup to mastery in minutes</p>
                    </div>
                  </div>

                  {/* Feature List */}
                  <div className="space-y-4 mb-8">
                    {[
                      { icon: FaUserPlus, title: 'Quick Signup', desc: 'Start in 30 seconds' },
                      { icon: FaTasks, title: 'Smart Tasks', desc: 'AI-powered organization' },
                      { icon: FaChartLine, title: 'Analytics', desc: 'Track your growth' },
                      { icon: FaFire, title: 'Streaks', desc: 'Build lasting habits' }
                    ].map((item, i) => (
                      <div key={i} className="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 hover:border-purple-500/30 transition-all duration-300 group">
                        <div className="w-12 h-12 bg-gradient-to-br from-purple-500/20 to-pink-500/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                          <item.icon className="text-purple-400 text-lg" />
                        </div>
                        <div className="flex-1">
                          <h4 className="text-white font-semibold group-hover:text-purple-400 transition-colors">{item.title}</h4>
                          <p className="text-gray-400 text-sm">{item.desc}</p>
                        </div>
                        <div className="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-purple-500/30 transition-colors">
                          <FaArrowRight className="text-gray-400 text-sm group-hover:text-white" />
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* CTA Button */}
                  <button
                    onClick={handleGetStarted}
                    className="w-full py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold rounded-2xl hover:from-purple-600 hover:to-pink-600 transition-all duration-300 shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 hover:scale-[1.02] flex items-center justify-center gap-3"
                  >
                    <span>Start Your Free Journey</span>
                    <FaArrowRight className="text-sm" />
                  </button>

                  {/* Trust Badges */}
                  <div className="mt-8 flex items-center justify-center gap-6">
                    <div className="flex items-center gap-2 text-gray-400 text-sm">
                      <FaShieldAlt className="text-green-400" />
                      <span>Secure</span>
                    </div>
                    <div className="flex items-center gap-2 text-gray-400 text-sm">
                      <FaBolt className="text-yellow-400" />
                      <span>Fast</span>
                    </div>
                    <div className="flex items-center gap-2 text-gray-400 text-sm">
                      <FaCheckCircle className="text-blue-400" />
                      <span>Free</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Floating badge */}
              <div className="absolute -top-4 -right-4 px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full text-white font-bold text-sm shadow-lg animate-bounce">
                100% Free Forever
              </div>
            </div>

            {/* Right Side - Animated Step-by-Step Guide */}
            <div className="relative">
              {/* Terminal Window */}
              <div className="bg-[#0d1117] rounded-2xl border border-white/10 shadow-2xl overflow-hidden">
                {/* Terminal Header */}
                <div className="flex items-center gap-2 px-4 py-3 bg-[#161b22] border-b border-white/5">
                  <div className="flex gap-2">
                    <div className="w-3 h-3 rounded-full bg-red-500/80"></div>
                    <div className="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                    <div className="w-3 h-3 rounded-full bg-green-500/80"></div>
                  </div>
                  <div className="flex-1 text-center">
                    <span className="text-gray-400 text-sm font-mono">tasklypro-guide.sh</span>
                  </div>
                </div>

                {/* Terminal Content */}
                <div className="p-6 font-mono text-sm min-h-[500px] relative">
                  {/* Scan line effect */}
                  <div className="absolute inset-0 bg-gradient-to-b from-transparent via-purple-500/5 to-transparent pointer-events-none animate-scan" style={{ animationDuration: '3s' }}></div>

                  {/* Step Indicator with Auto-play */}
                  <div className="flex items-center gap-2 mb-6 relative z-10">
                    <div className="flex gap-1">
                      {[1, 2, 3, 4, 5].map((step) => (
                        <div
                          key={step}
                          className={`w-3 h-3 rounded-full transition-all duration-300 cursor-pointer ${
                            activeGuideStep >= step
                              ? 'bg-purple-500 shadow-lg shadow-purple-500/50'
                              : 'bg-white/20'
                          } ${activeGuideStep === step ? 'scale-125 ring-2 ring-purple-400/50' : ''}`}
                          onClick={() => setActiveGuideStep(step)}
                        />
                      ))}
                    </div>
                    <span className="text-gray-400 text-xs ml-auto">
                      Step {activeGuideStep} of 5
                    </span>
                    <button
                      onClick={toggleAutoPlay}
                      className={`ml-2 px-3 py-1 rounded-full text-xs flex items-center gap-1 transition-all duration-300 ${
                        isAutoPlaying
                          ? 'bg-red-500/20 text-red-400 border border-red-500/30'
                          : 'bg-green-500/20 text-green-400 border border-green-500/30 hover:bg-green-500/30'
                      }`}
                    >
                      {isAutoPlaying ? (
                        <>
                          <span className="w-2 h-2 bg-red-400 rounded animate-pulse"></span>
                          Pause
                        </>
                      ) : (
                        <>
                          <FaPlay className="text-xs" />
                          Auto
                        </>
                      )}
                    </button>
                  </div>

                  {/* Typing Content */}
                  <div className="space-y-4">
                    {/* Step 1: Signup */}
                    {activeGuideStep >= 1 && (
                      <div className="space-y-2 animate-fadeIn">
                        <div className="flex items-center gap-2">
                          <span className="text-green-400">➜</span>
                          <span className="text-purple-400 font-bold">cd signup</span>
                        </div>
                        <div className="pl-4 space-y-1">
                          <div className="text-gray-300">
                            <span className="text-blue-400">$</span> npm run create-account
                          </div>
                          <div className="text-gray-400 text-xs">
                            {typingTexts.signup}
                            <span className="animate-pulse">|</span>
                          </div>
                          {activeGuideStep > 1 && (
                            <div className="text-green-400 text-xs mt-2">
                              ✓ Account created successfully!
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Step 2: Create Task */}
                    {activeGuideStep >= 2 && (
                      <div className="space-y-2 animate-fadeIn" style={{ animationDelay: '0.5s' }}>
                        <div className="flex items-center gap-2 mt-4">
                          <span className="text-green-400">➜</span>
                          <span className="text-pink-400 font-bold">cd add-task</span>
                        </div>
                        <div className="pl-4 space-y-1">
                          <div className="text-gray-300">
                            <span className="text-blue-400">$</span> taskly create "Finish report"
                          </div>
                          <div className="text-gray-400 text-xs">
                            {typingTexts.createTask}
                            <span className="animate-pulse">|</span>
                          </div>
                          {activeGuideStep > 2 && (
                            <div className="text-green-400 text-xs mt-2">
                              ✓ Task added with priority: HIGH
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Step 3: Projects */}
                    {activeGuideStep >= 3 && (
                      <div className="space-y-2 animate-fadeIn" style={{ animationDelay: '1s' }}>
                        <div className="flex items-center gap-2 mt-4">
                          <span className="text-green-400">➜</span>
                          <span className="text-cyan-400 font-bold">cd projects</span>
                        </div>
                        <div className="pl-4 space-y-1">
                          <div className="text-gray-300">
                            <span className="text-blue-400">$</span> taskly organize --project="Marketing"
                          </div>
                          <div className="text-gray-400 text-xs">
                            {typingTexts.projects}
                            <span className="animate-pulse">|</span>
                          </div>
                          {activeGuideStep > 3 && (
                            <div className="text-green-400 text-xs mt-2">
                              ✓ Task organized in "Marketing" project
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Step 4: Analytics */}
                    {activeGuideStep >= 4 && (
                      <div className="space-y-2 animate-fadeIn" style={{ animationDelay: '1.5s' }}>
                        <div className="flex items-center gap-2 mt-4">
                          <span className="text-green-400">➜</span>
                          <span className="text-yellow-400 font-bold">cd analytics</span>
                        </div>
                        <div className="pl-4 space-y-1">
                          <div className="text-gray-300">
                            <span className="text-blue-400">$</span> taskly stats --weekly
                          </div>
                          <div className="text-gray-400 text-xs">
                            {typingTexts.analytics}
                            <span className="animate-pulse">|</span>
                          </div>
                          {activeGuideStep > 4 && (
                            <div className="text-green-400 text-xs mt-2">
                              ✓ Weekly progress: 85% | Streak: 7 days!
                            </div>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Step 5: Success */}
                    {activeGuideStep >= 5 && (
                      <div className="space-y-2 animate-fadeIn" style={{ animationDelay: '2s' }}>
                        <div className="flex items-center gap-2 mt-4">
                          <span className="text-green-400">➜</span>
                          <span className="text-green-400 font-bold">cd success</span>
                        </div>
                        <div className="pl-4 space-y-1">
                          <div className="text-gray-300">
                            <span className="text-blue-400">$</span> taskly complete --all
                          </div>
                          <div className="text-green-400 text-xs mt-2">
                            {typingTexts.complete}
                            <span className="animate-pulse">|</span>
                          </div>
                          <div className="mt-3 p-3 bg-purple-500/10 rounded-lg border border-purple-500/30">
                            <div className="flex items-center gap-2 mb-2">
                              <span className="text-purple-400">💡</span>
                              <span className="text-purple-300 font-semibold text-xs">PRO TIP</span>
                            </div>
                            <p className="text-gray-400 text-xs">
                              Enable desktop notifications to never miss a task deadline!
                            </p>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Navigation Buttons */}
                  <div className="flex items-center gap-3 mt-6 pt-4 border-t border-white/5 relative z-10">
                    <button
                      onClick={prevGuideStep}
                      disabled={activeGuideStep <= 1}
                      className="px-4 py-2 bg-white/5 text-white text-sm rounded-xl hover:bg-white/10 transition-all disabled:opacity-30 disabled:cursor-not-allowed flex items-center gap-2"
                    >
                      <FaStepBackward className="text-xs" />
                      Prev
                    </button>
                    <button
                      onClick={nextGuideStep}
                      disabled={activeGuideStep >= 5}
                      className="flex-1 px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white text-sm rounded-xl hover:from-purple-600 hover:to-pink-600 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40"
                    >
                      {activeGuideStep >= 5 ? (
                        <>
                          <FaCheck className="text-sm" />
                          Complete!
                        </>
                      ) : (
                        <>
                          Next Step
                          <FaStepForward className="text-xs" />
                        </>
                      )}
                    </button>
                  </div>

                  {/* Progress Bar */}
                  <div className="mt-4 relative z-10">
                    <div className="flex justify-between text-xs text-gray-500 mb-1">
                      <span>Progress</span>
                      <span className="text-purple-400">{Math.round((activeGuideStep / 5) * 100)}%</span>
                    </div>
                    <div className="h-2 bg-white/10 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-gradient-to-r from-purple-500 via-pink-500 to-purple-500 transition-all duration-500 animate-gradient"
                        style={{ width: `${(activeGuideStep / 5) * 100}%` }}
                      />
                    </div>
                  </div>
                </div>
              </div>

              {/* Floating decoration */}
              <div className="absolute -bottom-6 -left-6 w-24 h-24 bg-gradient-to-br from-purple-500/30 to-pink-500/30 rounded-2xl blur-xl"></div>
              <div className="absolute -top-6 -right-6 w-20 h-20 bg-gradient-to-br from-cyan-500/30 to-blue-500/30 rounded-2xl blur-xl"></div>
            </div>
          </div>
        </div>
      </section>

      {/* Footer */}
      <footer className="py-12 border-t border-white/5 bg-white/[0.02]">
        <style>{`
          @keyframes scan {
            0%, 100% {
              transform: translateY(-100%);
            }
            50% {
              transform: translateY(100%);
            }
          }
          .animate-scan {
            animation: scan 3s ease-in-out infinite;
          }
          .animate-on-scroll {
            opacity: 0;
            transform: translateY(2rem);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
          }
          .animate-on-scroll.animate-in {
            opacity: 1;
            transform: translateY(0);
          }
          .delay-100 { transition-delay: 0.1s; }
          .delay-200 { transition-delay: 0.2s; }
          .delay-300 { transition-delay: 0.3s; }
          .delay-400 { transition-delay: 0.4s; }
          .delay-500 { transition-delay: 0.5s; }
          @keyframes float {
            0%, 100% {
              transform: translateY(0px) rotate(0deg);
            }
            50% {
              transform: translateY(-20px) rotate(5deg);
            }
          }
          .animate-float {
            animation: float 6s ease-in-out infinite;
          }
          @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
          }
          .animate-gradient {
            background-size: 200% 200%;
            animation: gradient 3s ease infinite;
          }

          /* Aurora Waves Animation */
          @keyframes auroraWave1 {
            0%, 100% {
              transform: translateX(-50%) translateY(0) scaleY(1);
              opacity: 0.4;
            }
            25% {
              transform: translateX(-45%) translateY(-20px) scaleY(1.2);
              opacity: 0.6;
            }
            50% {
              transform: translateX(-55%) translateY(10px) scaleY(0.8);
              opacity: 0.3;
            }
            75% {
              transform: translateX(-40%) translateY(-10px) scaleY(1.1);
              opacity: 0.5;
            }
          }
          @keyframes auroraWave2 {
            0%, 100% {
              transform: translateX(0) translateY(0) scaleY(1);
              opacity: 0.35;
            }
            33% {
              transform: translateX(30px) translateY(-30px) scaleY(1.3);
              opacity: 0.55;
            }
            66% {
              transform: translateX(-20px) translateY(20px) scaleY(0.9);
              opacity: 0.25;
            }
          }
          @keyframes auroraWave3 {
            0%, 100% {
              transform: translateX(50%) translateY(0) scaleY(1);
              opacity: 0.3;
            }
            50% {
              transform: translateX(60%) translateY(-25px) scaleY(1.15);
              opacity: 0.5;
            }
          }
          @keyframes auroraWave4 {
            0%, 100% {
              transform: translateX(25%) translateY(0) scaleY(1) skewX(0deg);
              opacity: 0.4;
            }
            25% {
              transform: translateX(35%) translateY(-15px) scaleY(1.1) skewX(2deg);
              opacity: 0.6;
            }
            75% {
              transform: translateX(15%) translateY(10px) scaleY(0.9) skewX(-2deg);
              opacity: 0.3;
            }
          }

          .aurora-wave {
            position: absolute;
            width: 150vw;
            height: 400px;
            left: 50%;
            transform: translateX(-50%);
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.4;
            pointer-events: none;
          }

          .aurora-1 {
            top: 10%;
            background: linear-gradient(90deg,
              rgba(139, 92, 246, 0) 0%,
              rgba(139, 92, 246, 0.6) 30%,
              rgba(168, 85, 247, 0.8) 50%,
              rgba(139, 92, 246, 0.6) 70%,
              rgba(139, 92, 246, 0) 100%
            );
            animation: auroraWave1 8s ease-in-out infinite;
          }

          .aurora-2 {
            top: 25%;
            background: linear-gradient(90deg,
              rgba(236, 72, 153, 0) 0%,
              rgba(236, 72, 153, 0.5) 30%,
              rgba(244, 114, 182, 0.7) 50%,
              rgba(236, 72, 153, 0.5) 70%,
              rgba(236, 72, 153, 0) 100%
            );
            animation: auroraWave2 10s ease-in-out infinite;
            animation-delay: -2s;
          }

          .aurora-3 {
            top: 40%;
            background: linear-gradient(90deg,
              rgba(20, 184, 166, 0) 0%,
              rgba(20, 184, 166, 0.4) 30%,
              rgba(45, 212, 191, 0.6) 50%,
              rgba(20, 184, 166, 0.4) 70%,
              rgba(20, 184, 166, 0) 100%
            );
            animation: auroraWave3 12s ease-in-out infinite;
            animation-delay: -4s;
          }

          .aurora-4 {
            top: 55%;
            background: linear-gradient(90deg,
              rgba(139, 92, 246, 0.3) 0%,
              rgba(236, 72, 153, 0.5) 25%,
              rgba(168, 85, 247, 0.7) 50%,
              rgba(236, 72, 153, 0.5) 75%,
              rgba(139, 92, 246, 0.3) 100%
            );
            animation: auroraWave4 9s ease-in-out infinite;
            animation-delay: -6s;
            filter: blur(80px);
          }

          /* Floating Particles Animation */
          @keyframes floatParticle {
            0%, 100% {
              transform: translateY(0) translateX(0) scale(1);
              opacity: 0.6;
            }
            25% {
              transform: translateY(-40px) translateX(20px) scale(1.2);
              opacity: 1;
            }
            50% {
              transform: translateY(-20px) translateX(-10px) scale(0.8);
              opacity: 0.4;
            }
            75% {
              transform: translateY(-60px) translateX(15px) scale(1.1);
              opacity: 0.8;
            }
          }

          .floating-particles {
            position: absolute;
            inset: 0;
            pointer-events: none;
          }

          .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            animation: floatParticle 6s ease-in-out infinite;
          }

          .particle-1 {
            top: 15%;
            left: 20%;
            background: rgba(139, 92, 246, 0.9);
            animation-delay: 0s;
          }
          .particle-2 {
            top: 25%;
            right: 25%;
            background: rgba(236, 72, 153, 0.9);
            animation-delay: 1s;
          }
          .particle-3 {
            top: 35%;
            left: 70%;
            background: rgba(168, 85, 247, 0.8);
            animation-delay: 2s;
          }
          .particle-4 {
            top: 45%;
            right: 15%;
            background: rgba(20, 184, 166, 0.9);
            animation-delay: 0.5s;
          }
          .particle-5 {
            top: 55%;
            left: 30%;
            background: rgba(139, 92, 246, 0.7);
            animation-delay: 1.5s;
          }
          .particle-6 {
            top: 65%;
            right: 35%;
            background: rgba(236, 72, 153, 0.8);
            animation-delay: 2.5s;
          }
          .particle-7 {
            top: 75%;
            left: 55%;
            background: rgba(168, 85, 247, 0.9);
            animation-delay: 3s;
          }
          .particle-8 {
            top: 85%;
            right: 20%;
            background: rgba(20, 184, 166, 0.7);
            animation-delay: 1.2s;
          }
        `}</style>
      </div>
    </div>
    <HomeFooter />
  );
};

export default Home;
