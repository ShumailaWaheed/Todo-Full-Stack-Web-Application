                  <div className="relative z-10">
                    <div className="absolute -top-4 left-1/2 -translate-x-1/2 w-12 h-12 bg-gradient-to-r from-pink-500 to-rose-500 rounded-full flex items-center justify-center text-white font-black text-lg shadow-lg z-10 group-hover:scale-110 group-hover:-rotate-3 transition-all duration-300">
                      2
                    </div>

                    <div className="flex justify-center mb-6 mt-4">
                      <div className="relative">
                        <div className="w-20 h-20 rounded-2xl bg-gradient-to-br from-pink-500/20 to-rose-500/20 flex items-center justify-center group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-500 border border-white/10">
                          <FaPlus className="text-3xl text-pink-400" />
                        </div>
                        {/* Floating particles */}
                        <div className="absolute -top-2 -right-2 w-3 h-3 bg-pink-500/50 rounded-full animate-pulse" style={{ animationDelay: '0.3s' }}></div>
                        <div className="absolute -bottom-2 -left-2 w-2 h-2 bg-rose-500/50 rounded-full animate-pulse" style={{ animationDelay: '0.8s' }}></div>
                      </div>
                    </div>

                    <h3 className="text-xl font-bold text-white mb-4 text-center group-hover:text-pink-400 transition-colors duration-300">
