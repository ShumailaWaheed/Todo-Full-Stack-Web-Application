// frontend/components/home/home.tsx
'use client';

import React, { useState, useEffect, useRef } from 'react';
import { useAuth } from '../../lib/auth/context';
import { useRouter } from 'next/navigation';
import {
  FaChartBar,
  FaBolt,
  FaCheckCircle,
  FaStar,
  FaShieldAlt,
  FaArrowRight,
  FaUserPlus,
  FaPlus,
  FaChartLine,
  FaFlag,
  FaFire,
  FaMobileAlt,
  FaRocket,
  FaChevronDown,
  FaPlay,
  FaStepBackward,
  FaStepForward,
  FaCheck
} from 'react-icons/fa';
import HomeHeader from '../ui/home-header';
import HomeFooter from '../ui/home-footer';

const Home: React.FC = () => {
  const { user } = useAuth();
  const router = useRouter();
  const [isScrolled, setIsScrolled] = useState(false);
  const [currentWalkthroughStep, setCurrentWalkthroughStep] = useState(1);
  const [openFaqIndex, setOpenFaqIndex] = useState<number | null>(null);

  const walkthroughSteps = [
    { title: 'View Your Tasks', description: 'See all your tasks organized in one place with priority indicators' },
    { title: 'Quick Add Task', description: 'Create new tasks instantly with priority and due dates' },
    { title: 'Track Progress', description: 'Watch your productivity grow with animated charts' },
    { title: 'Build Streaks', description: 'Maintain daily streaks and achieve your goals' }
  ];

  const faqItems = [
    {
      question: 'Is TasklyPro really free?',
      answer: 'Yes! TasklyPro is completely free to use. All core features including task management, projects, analytics, and streak tracking are available at no cost. We believe everyone should have access to powerful productivity tools.'
    },
    {
      question: 'How do I get started?',
      answer: 'Simply click the "Sign Up Free" button in the top right corner. You can create an account with your email or use Google SSO for quick access. No credit card required!'
    },
    {
      question: 'Can I use TasklyPro on mobile?',
      answer: 'Absolutely! TasklyPro is fully responsive and works seamlessly on all devices. We also offer dedicated mobile apps for iOS and Android for the best experience on the go.'
    },
    {
      question: 'Is my data secure?',
      answer: 'Yes, we take security very seriously. All your data is encrypted and stored securely. We never share your personal information with third parties. Your privacy is our top priority.'
    },
    {
      question: 'How does streak tracking work?',
      answer: 'Streaks reward you for maintaining daily productivity! Complete at least one task every day to keep your streak alive. Streaks motivate you to stay consistent and build productive habits.'
    },
    {
      question: 'Can I organize tasks into projects?',
      answer: 'Yes! You can create multiple projects and organize your tasks within them. This helps you keep work, personal goals, and different areas of life separate and focused.'
    }
  ];

  const [activeGuideStep, setActiveGuideStep] = useState(1);
  const [isAutoPlaying, setIsAutoPlaying] = useState(false);
  const [cursorPosition, setCursorPosition] = useState({ line: 5, col: 0 });

  // Typing animation texts
  const [typingTexts, setTypingTexts] = useState({
    signup: '',
    createTask: '',
    projects: '',
    analytics: '',
    complete: ''
  });

  // Auto-play functionality
  useEffect(() => {
    let interval: NodeJS.Timeout;
    if (isAutoPlaying) {
      interval = setInterval(() => {
        setActiveGuideStep(prev => {
          if (prev >= 5) {
            setIsAutoPlaying(false);
            return 1;
          }
          return prev + 1;
        });
      }, 3000);
    }
    return () => clearInterval(interval);
  }, [isAutoPlaying]);

  // Typing effect for each step
  useEffect(() => {
    const stepTexts: Record<number, { key: keyof typeof typingTexts; text: string }> = {
      1: { key: 'signup', text: 'Creating your account with email verification...' },
      2: { key: 'createTask', text: 'Adding task "Finish quarterly report" with priority HIGH...' },
      3: { key: 'projects', text: 'Organizing into "Work" project with smart labels...' },
      4: { key: 'analytics', text: 'Weekly progress: 85% | Tasks completed: 24 | Streak: 7 days!' },
      5: { key: 'complete', text: 'Congratulations! You have completed the productivity tour!' }
    };

    const currentStepText = stepTexts[activeGuideStep];
    if (currentStepText) {
      setTypingTexts(prev => ({ ...prev, [currentStepText.key]: '' }));

      let charIndex = 0;
      const text = currentStepText.text;
      const interval = setInterval(() => {
        if (charIndex < text.length) {
          setTypingTexts(prev => ({
            ...prev,
            [currentStepText.key]: text.slice(0, charIndex + 1)
          }));
          setCursorPosition({ line: activeGuideStep, col: charIndex });
          charIndex++;
        } else {
          clearInterval(interval);
        }
      }, 25);
    }
  }, [activeGuideStep]);

  const nextGuideStep = () => {
    if (activeGuideStep < 5) {
      setActiveGuideStep(activeGuideStep + 1);
    }
  };

  const prevGuideStep = () => {
    if (activeGuideStep > 1) {
      setActiveGuideStep(activeGuideStep - 1);
    }
  };

  const toggleAutoPlay = () => {
    setIsAutoPlaying(!isAutoPlaying);
  };

  const toggleFaq = (index: number) => {
    setOpenFaqIndex(openFaqIndex === index ? null : index);
  };

  // Animated Counter Hook
  const useAnimatedCounter = (target: number, duration: number = 2000) => {
    const [count, setCount] = useState(0);
    const elementRef = useRef<HTMLDivElement>(null);
    const hasAnimated = useRef(false);

    useEffect(() => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasAnimated.current) {
              hasAnimated.current = true;
              const startTimestamp = performance.now();
              const startValue = 0;
              const endValue = target;

              const animate = (currentTime: number) => {
                const elapsed = currentTime - startTimestamp;
                const progress = Math.min(elapsed / duration, 1);
                const easeOutQuart = 1 - Math.pow(1 - progress, 4);
                const currentValue = startValue + (endValue - startValue) * easeOutQuart;

                if (endValue >= 1000) {
                  setCount(Math.floor(currentValue / 1000) * 1000 + (currentValue % 1000 >= 500 ? 1000 : 0));
                } else {
                  setCount(Math.floor(currentValue));
                }

                if (progress < 1) {
                  requestAnimationFrame(animate);
                }
              };

              requestAnimationFrame(animate);
            }
          });
        },
        { threshold: 0.5 }
      );

      if (elementRef.current) {
        observer.observe(elementRef.current);
      }

      return () => observer.disconnect();
    }, [target, duration]);

    return { count, elementRef };
  };

  // Animated Counter Component
  const AnimatedCounter = ({ value, suffix = '' }: { value: number; suffix?: string }) => {
    const { count, elementRef } = useAnimatedCounter(value);

    const formatCount = (num: number) => {
      if (value >= 1000) {
        return (num / 1000).toFixed(0) + 'K+';
      }
      return num + suffix;
    };

    return (
      <div ref={elementRef} className="text-4xl md:text-5xl font-black text-white mb-2">
        {formatCount(count)}
      </div>
    );
  };

  // Floating Task Card Component
  const FloatingCard = ({ delay, x, y, rotation }: { delay: number; x: string; y: string; rotation: number }) => {
    const [isHovered, setIsHovered] = useState(false);

    return (
      <div
        className={`absolute animate-float opacity-20 hover:opacity-40 transition-opacity duration-300 cursor-pointer`}
        style={{
          left: x,
          top: y,
          animationDelay: `${delay}s`,
          transform: `rotate(${rotation}deg)`
        }}
        onMouseEnter={() => setIsHovered(true)}
        onMouseLeave={() => setIsHovered(false)}
      >
        <div className={`bg-gradient-to-br from-purple-500/50 to-pink-500/50 backdrop-blur-lg rounded-2xl p-4 shadow-2xl transition-all duration-500 ${isHovered ? 'scale-110 shadow-purple-500/50' : ''}`}>
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
              <FaTasks className="text-white text-lg" />
            </div>
            <div>
              <div className="w-20 h-2 bg-white/30 rounded mb-1"></div>
              <div className="w-14 h-2 bg-white/20 rounded"></div>
            </div>
          </div>
        </div>
      </div>
    );
  };

  // Pulse Ring Component
  const PulseRing = ({ delay }: { delay: number }) => (
    <div
      className="absolute rounded-full border border-purple-500/30 animate-ping"
      style={{
        width: '100px',
        height: '100px',
        left: '50%',
        top: '50%',
        marginLeft: '-50px',
        marginTop: '-50px',
        animationDelay: `${delay}s`,
        animationDuration: '3s'
      }}
    />
  );

  // Tooltip Tour Component
  const TooltipTour = () => {
    const [activeTooltip, setActiveTooltip] = useState<number | null>(null);

    const tourSteps = [
      {
        id: 1,
        title: "Task List",
        description: "View all your tasks with priority badges",
        position: "top-24 left-8"
      },
      {
        id: 2,
        title: "Quick Add",
        description: "Create tasks instantly with one click",
        position: "top-24 right-8"
      },
      {
        id: 3,
        title: "Stats Card",
        description: "Track your daily progress at a glance",
        position: "top-8 left-8"
      },
      {
        id: 4,
        title: "Streak Counter",
        description: "Build streaks by completing daily goals",
        position: "top-8 right-8"
      }
    ];

    return (
      <div className="relative">
        {/* Tooltip Hotspots */}
        {tourSteps.map((step) => (
          <div
            key={step.id}
            className={`absolute ${step.position} cursor-pointer z-20`}
            onMouseEnter={() => setActiveTooltip(step.id)}
            onMouseLeave={() => setActiveTooltip(null)}
          >
            <div className={`relative group`}>
              {/* Pulsing Hotspot */}
              <div className="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center cursor-pointer animate-pulse shadow-lg shadow-purple-500/50">
                <span className="text-white text-xs font-bold">{step.id}</span>
              </div>

              {/* Tooltip */}
              <div className={`absolute left-8 top-0 w-48 bg-black/90 backdrop-blur-xl rounded-xl p-3 border border-purple-500/30 transition-all duration-300 ${activeTooltip === step.id ? 'opacity-100 scale-100 translate-x-0' : 'opacity-0 scale-95 -translate-x-2 pointer-events-none'}`}>
                <div className="flex items-start gap-2">
                  <div className="w-2 h-2 bg-purple-500 rounded-full mt-1.5"></div>
                  <div>
                    <h4 className="text-white font-semibold text-sm">{step.title}</h4>
                    <p className="text-gray-400 text-xs mt-0.5">{step.description}</p>
                  </div>
                </div>
                {/* Tooltip Arrow */}
                <div className="absolute left-0 top-3 -translate-x-1 w-2 h-2 bg-black/90 border-l border-t border-purple-500/30 transform rotate-45"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    );
  };

  // Scroll observer for animations
  useEffect(() => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          entry.target.classList.remove('opacity-0', 'translate-y-8');
        }
      });
    }, observerOptions);

    const animatedElements = document.querySelectorAll('.animate-on-scroll');
    animatedElements.forEach((el) => observer.observe(el));

    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 10);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    if (user) {
      router.push('/dashboard');
    }
  }, [user, router]);

  const handleGetStarted = () => {
    router.push('/auth/sign-up');
  };

  const handleLearnMore = () => {
    const featuresSection = document.getElementById('features');
    if (featuresSection) {
      featuresSection.scrollIntoView({ behavior: 'smooth' });
    }
  };

  const features = [
    {
      title: "Smart Tasks",
      description: "Create, organize and prioritize tasks with intelligent suggestions",
      icon: <FaTasks className="text-2xl" />,
      color: "#8b5cf6"
    },
    {
      title: "Priority Levels",
      description: "High, medium and low priority to focus on what matters most",
      icon: <FaFlag className="text-2xl" />,
      color: "#ef4444"
    },
    {
      title: "Project Management",
      description: "Organize tasks into projects for better workflow management",
      icon: <FaChartLine className="text-2xl" />,
      color: "#3b82f6"
    },
    {
      title: "Progress Analytics",
      description: "Visual reports and productivity metrics to track your growth",
      icon: <FaChartBar className="text-2xl" />,
      color: "#10b981"
    },
    {
      title: "Streak Tracking",
      description: "Build habits and maintain streaks with daily task completion",
      icon: <FaFire className="text-2xl" />,
      color: "#f59e0b"
    },
    {
      title: "Activity Insights",
      description: "Heatmap and timeline to visualize your productivity patterns",
      icon: <FaBolt className="text-2xl" />,
      color: "#ec4899"
    }
  ];

  const whyChooseUs = [
    {
      icon: <FaRocket className="text-3xl" />,
      title: "Lightning Fast",
      description: "Built for speed with instant sync across all your devices"
    },
    {
      icon: <FaShieldAlt className="text-3xl" />,
      title: "Secure & Private",
      description: "Your data is encrypted and never shared with third parties"
    },
    {
      icon: <FaMobileAlt className="text-3xl" />,
      title: "Dark Mode Ready",
      description: "Beautiful dark theme that's easy on the eyes day or night"
    },
    {
      icon: <FaCheckCircle className="text-3xl" />,
      title: "Free Forever",
      description: "All core features available free with no hidden charges"
    }
  ];

  const stats = [
    { value: 50000, label: "Active Users" },
    { value: 1000000, label: "Tasks Completed" },
    { value: 10000, label: "Projects Managed" }
  ];

  return (
    <div className="min-h-screen bg-[#0a0a0f] relative overflow-hidden">
      {/* Animated Background */}
      <div className="fixed inset-0 pointer-events-none">
        <div className="absolute top-0 left-1/4 w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[120px] animate-pulse"></div>
        <div className="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-pink-500/10 rounded-full blur-[100px] animate-pulse delay-1000"></div>
        <div className="absolute top-1/2 left-1/2 w-[300px] h-[300px] bg-teal-500/10 rounded-full blur-[80px] animate-pulse delay-500"></div>
      </div>

      {/* Floating Task Cards - Aurora Waves Background Effect */}
      <div className="fixed inset-0 pointer-events-none overflow-hidden">
        {/* Aurora Wave 1 - Purple */}
        <div className="aurora-wave aurora-1"></div>
        {/* Aurora Wave 2 - Pink */}
        <div className="aurora-wave aurora-2"></div>
        {/* Aurora Wave 3 - Teal */}
        <div className="aurora-wave aurora-3"></div>
        {/* Aurora Wave 4 - Gradient Mix */}
        <div className="aurora-wave aurora-4"></div>
        {/* Floating Particles */}
        <div className="floating-particles">
          <div className="particle particle-1"></div>
          <div className="particle particle-2"></div>
          <div className="particle particle-3"></div>
          <div className="particle particle-4"></div>
          <div className="particle particle-5"></div>
          <div className="particle particle-6"></div>
          <div className="particle particle-7"></div>
          <div className="particle particle-8"></div>
        </div>
      </div>

      <HomeHeader />


      {/* Hero Section */}
      <section className="pt-32 pb-20 relative">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center max-w-4xl mx-auto">
            {/* Badge */}
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 relative overflow-hidden group">
              <div className="absolute inset-0 bg-gradient-to-r from-purple-500/20 to-pink-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <span className="w-2 h-2 bg-[#10b981] rounded-full animate-pulse relative z-10"></span>
              <span className="text-sm text-gray-400 relative z-10">Now with AI-powered suggestions</span>
            </div>

            {/* Main Heading */}
            <h1 className="text-5xl md:text-6xl lg:text-7xl font-black text-white mb-6 leading-tight">
              Master Your Workflow.
              <span className="block text-[#8b5cf6] bg-gradient-to-r from-[#8b5cf6] to-[#ec4899] bg-clip-text text-transparent animate-gradient bg-[length:200%_200%]">
                Achieve More Every Day.
              </span>
            </h1>

            {/* Subtitle */}
            <p className="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
              The modern task management solution designed for productivity.
              Organize, prioritize, and accomplish your goals with ease.
            </p>

            {/* CTA Buttons */}
            <div className="flex flex-col sm:flex-row gap-4 justify-center">
              <button
                onClick={handleGetStarted}
                className="group relative px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-semibold rounded-2xl hover:from-purple-600 hover:to-pink-600 transition-all duration-300 shadow-lg shadow-purple-500/30 overflow-hidden"
              >
                <div className="absolute inset-0 bg-gradient-to-r from-white/20 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-500 skew-x-12"></div>
                <span className="relative flex items-center justify-center gap-2">
                  <FaUserPlus className="text-lg" />
                  Start Free Today
                  <FaArrowRight className="text-sm transition-transform group-hover:translate-x-1" />
                </span>
              </button>
              <button
                onClick={handleLearnMore}
                className="group px-8 py-4 bg-white/5 text-white font-semibold rounded-2xl border border-white/10 hover:bg-white/10 hover:border-purple-500/50 transition-all duration-300 flex items-center justify-center gap-2"
              >
                <FaBolt className="text-lg group-hover:text-yellow-400 transition-colors" />
                See How It Works
              </button>
            </div>

            {/* Social Proof */}
            <div className="mt-16 flex items-center justify-center gap-8">
              <div className="flex -space-x-3">
                {[1,2,3,4,5].map((i) => (
                  <div
                    key={i}
                    className="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 border-2 border-[#0a0a0f] flex items-center justify-center text-white text-xs font-bold ring-2 ring-purple-500/30 animate-pulse"
                    style={{ animationDelay: `${i * 0.1}s` }}
                  >
                    {String.fromCharCode(64 + i)}
                  </div>
                ))}
              </div>
              <div className="text-left">
                <div className="flex items-center gap-1">
                  {[1,2,3,4,5].map((i) => (
                    <FaStar key={i} className="text-yellow-400 text-sm animate-pulse" style={{ animationDelay: `${i * 0.1}s` }} />
                  ))}
                </div>
                <p className="text-sm text-gray-400">Trusted by 50,000+ users</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Stats Section - Animated Counters */}
      <section className="py-16 border-y border-white/5 bg-white/[0.02] animate-on-scroll">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
            {stats.map((stat, index) => (
              <div key={index} className="text-center group">
                <AnimatedCounter value={stat.value} />
                <div className="text-gray-400 font-medium group-hover:text-purple-400 transition-colors duration-300">
                  {stat.label}
                </div>
                <div className="w-16 h-1 bg-gradient-to-r from-purple-500 to-pink-500 mx-auto mt-4 rounded-full opacity-50 group-hover:opacity-100 group-hover:scale-x-125 transition-all duration-300"></div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Why Choose Us */}
      <section className="py-24 bg-white/[0.02] border-y border-white/5 animate-on-scroll">
        {/* Animated Background Elements */}
        <div className="absolute inset-0 overflow-hidden pointer-events-none">
          <div className="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse"></div>
          <div className="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl animate-pulse" style={{ animationDelay: '1s' }}></div>
        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
          <div className="text-center mb-16">
            <h2 className="text-4xl md:text-5xl font-black text-white mb-4">
              Why Choose <span className="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">TasklyPro</span>?
            </h2>
            <p className="text-xl text-gray-400 max-w-2xl mx-auto">
              Built for productivity, designed for simplicity
            </p>
          </div>


          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
            {whyChooseUs.map((item, index) => (
              <div
                key={index}
                className="relative text-center p-8 rounded-[2rem] bg-gradient-to-br from-white/5 to-white/0 border border-white/10 hover:border-purple-500/50 transition-all duration-500 group animate-on-scroll hover:-translate-y-2 hover:shadow-2xl hover:shadow-purple-500/20 overflow-hidden"
                style={{ transitionDelay: `${index * 100}ms` }}
              >
                {/* Glow effect */}
                <div className="absolute inset-0 bg-gradient-to-br from-purple-500/10 via-transparent to-pink-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                {/* Floating icon background */}
                <div className="absolute -top-10 -right-10 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all duration-500"></div>

                <div className="relative z-10">
                  <div className="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-purple-500/20 to-pink-500/20 rounded-2xl flex items-center justify-center text-purple-400 group-hover:scale-110 group-hover:text-purple-300 group-hover:rotate-3 transition-all duration-300 border border-white/10 group-hover:border-purple-500/30">
                    {item.icon}
                  </div>
                  <h3 className="text-lg font-bold text-white mb-3 group-hover:text-purple-400 transition-colors duration-300">
                    {item.title}
                  </h3>
                  <p className="text-gray-400 text-sm leading-relaxed group-hover:text-gray-300 transition-colors duration-300">
                    {item.description}
                  </p>
                </div>

                {/* Arrow indicator */}
                <div className="absolute bottom-4 right-4 w-8 h-8 rounded-full bg-white/5 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300">
                  <FaArrowRight className="text-purple-400 text-xs" />
                </div>
              </div>
            ))}
          </div>

          {/* Bottom CTA */}
          <div className="mt-16 text-center">
            <div className="inline-flex items-center gap-4 px-6 py-3 bg-white/5 rounded-full border border-white/10">
              <span className="text-gray-400 text-sm">Trusted by 50,000+ productive teams worldwide</span>
              <div className="flex -space-x-2">
                {[1, 2, 3, 4].map((i) => (
                  <div key={i} className="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 border-2 border-[#0a0a0f]"></div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* How It Works */}
      <section id="how-it-works" className="py-24 relative animate-on-scroll">
        {/* Animated Background */}
        <div className="absolute inset-0 overflow-hidden pointer-events-none">
          <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full max-w-4xl max-h-64 bg-gradient-to-r from-purple-500/5 via-transparent to-pink-500/5 rounded-full blur-3xl"></div>
        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
